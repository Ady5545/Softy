{
  "rules": {
    "softyRooms": {
      "143": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['type','senderUid','iv','ciphertext','createdAt']) && newData.child('type').val() === 'message' && newData.child('senderUid').val() === auth.uid && newData.child('iv').isString() && newData.child('ciphertext').isString()"
          }
        },
        "typing": {
          "$uid": {
            ".validate": "$uid === auth.uid"
          }
        }
      }
    }
  }
}